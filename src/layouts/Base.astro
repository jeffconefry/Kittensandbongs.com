---
import '@fontsource/anton/latin-400.css';
import '@fontsource/space-mono/latin-400.css';
import '@fontsource/space-mono/latin-700.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Kittens & Bongs',
  description = 'One cute kitten and one bong, every day. Humor for adults 21+.',
  image,
} = Astro.props;

const indexable = import.meta.env.PUBLIC_SITE_INDEXABLE === 'true';
const tipUrl = import.meta.env.PUBLIC_TIP_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();

const tickerItems = ['21+ only', 'One kitten', 'One bong', 'Every day', 'New drop 7 a.m. ET'];
// The track holds the line twice so the scroll loops seamlessly; the copy is hidden from screen readers.
const tickerRun = Array.from({ length: 4 }, () => tickerItems).flat();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#111111" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="rating" content="adult" />
    <script is:inline>
      try {
        if (localStorage.getItem('kab-age') === 'ok') document.documentElement.classList.add('age-ok');
      } catch (_) {}
    </script>
    <noscript><style>.gate { display: none !important; }</style></noscript>
  </head>
  <body>
    <div class="gate" role="dialog" aria-modal="true" aria-labelledby="gate-title">
      <div class="gate-top">
        <span class="wordmark-text">Kittens <span class="amp">&amp;</span> Bongs</span>
      </div>
      <div class="gate-body">
        <p class="gate-big" aria-hidden="true">21+</p>
        <h2 id="gate-title">Old enough to be here?</h2>
        <p>This site puts a picture of a bong next to a picture of a kitten every day. That's the whole joke. You need to be 21 or older to come in.</p>
        <div class="gate-actions">
          <button type="button" class="btn btn-accent" data-age="yes">I'm 21+ — let me in</button>
          <a class="btn btn-ghost-light" href="https://www.pexels.com/search/kitten/" rel="noopener">Not yet — just kittens</a>
        </div>
      </div>
      <p class="gate-fine">We remember your answer in this browser only. No account needed.</p>
    </div>

    <div class="ticker">
      <div class="ticker-track">
        {
          [0, 1].map((copy) => (
            <p class="note" aria-hidden={copy === 1 ? 'true' : undefined}>
              {tickerRun.map((t) => (
                <span>{t.toUpperCase()} /</span>
              ))}
            </p>
          ))
        }
      </div>
    </div>

    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="wordmark" aria-label="Kittens and Bongs, home">
          <span class="wordmark-text">Kittens <span class="amp">&amp;</span> Bongs</span>
          <span class="sticker-21" aria-hidden="true">21+</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <a class="pill" href="/archive">Archive</a>
          {tipUrl && <a class="pill" href={tipUrl} rel="noopener" target="_blank">Tip jar</a>}
          <a class="pill pill-solid" href="/#signup">Subscribe</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <div class="footer-brand">
          <strong>Kittens &amp; Bongs</strong>
          <span>One kitten. One bong. Every day.</span>
        </div>
        <nav class="footer-nav" aria-label="Footer">
          <a href="https://www.pexels.com" rel="noopener">Photos by Pexels</a>
          <a href="/archive">Archive</a>
          <a href="/privacy">Privacy</a>
        </nav>
        <p class="footer-fine">
          For adults 21+. Humor only: nothing here is for sale, and nothing here is advice. Photos are credited to each
          photographer. © {year} kittensandbongs.com
        </p>
      </div>
    </footer>

    <script>
      const btn = document.querySelector<HTMLButtonElement>('[data-age="yes"]');
      btn?.addEventListener('click', () => {
        try {
          localStorage.setItem('kab-age', 'ok');
        } catch (_) {}
        document.documentElement.classList.add('age-ok');
      });
    </script>
  </body>
</html>
