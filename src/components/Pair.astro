---
import type { DayPair, Photo } from '../lib/db';
import { longDate } from '../lib/day';

interface Props {
  pair: DayPair;
  today?: boolean;
  /** Next drop time shown beside the date on the home page, e.g. "7 a.m. ET". */
  nextDrop?: string;
}
const { pair, today = false, nextDrop } = Astro.props;

const heading = today ? 'Today’s drop' : 'The drop';

// No inline style attributes: the CSP hashes inline <style>/<script> blocks,
// and hashed policies block style="" attributes.
const cards: { label: string; tag: string; photo: Photo }[] = [
  { label: 'Kitten', tag: 'tag-kitten', photo: pair.cat },
  { label: 'Bong', tag: 'tag-bong', photo: pair.bong },
];
---

<section class="pair">
  <header class="pair-head">
    <h1>{heading}</h1>
    <p class="kicker">
      <time datetime={pair.day}>{longDate(pair.day)}</time>
      {nextDrop && <><br />Next drop {nextDrop}</>}
    </p>
  </header>

  <div class="cards">
    {
      cards.map(({ label, tag, photo }, i) => (
        <>
          {i === 1 && (
            <span class="and" aria-hidden="true">
              &amp;
            </span>
          )}
          <figure class="card">
            <a href={photo.page_url} rel="noopener" class="frame">
              <span class:list={['tag', tag]}>{label}</span>
              <img
                src={photo.src_large}
                srcset={`${photo.src_large} 1x, ${photo.src_large2x} 2x`}
                alt={photo.alt}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </a>
            <figcaption>
              Photo:{' '}
              <a href={photo.photographer_url} rel="noopener">
                {photo.photographer}
              </a>{' '}
              on <a href={photo.page_url} rel="noopener">Pexels</a>
            </figcaption>
          </figure>
        </>
      ))
    }
  </div>
</section>

<style>
  .pair {
    padding: 2.5rem 0 3.5rem;
  }
  .pair-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .pair-head h1 {
    margin: 0;
  }
  .cards {
    margin-top: 1.75rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
  }
  .and {
    font-family: var(--display);
    font-size: clamp(3.5rem, 6vw, 5rem);
    line-height: 1;
    color: var(--accent);
    text-align: center;
  }
  .card {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .frame {
    position: relative;
    display: block;
    aspect-ratio: 1;
    border: var(--rule);
    background: var(--ph);
    overflow: hidden;
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tag {
    position: absolute;
    z-index: 1;
    top: 1rem;
    left: 1rem;
    padding: 0.2rem 0.85rem;
    font: 1.6rem/1.2 var(--display);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .tag-kitten {
    background: var(--ink);
    color: var(--ground);
    transform: rotate(-3deg);
  }
  .tag-bong {
    background: var(--accent);
    color: var(--ink);
    border: 2px solid var(--ink);
    transform: rotate(2deg);
  }
  .frame:hover {
    border-color: var(--accent);
  }
  figcaption {
    font-size: 0.8rem;
  }
  @media (max-width: 760px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
    .and {
      margin: -0.5rem 0;
    }
  }
</style>
