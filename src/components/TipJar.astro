---
interface Props {
  url: string;
}
const { url } = Astro.props;
---

<section class="panel panel-dark tip">
  <h2>Feed the jar</h2>
  <p>No ads. If the daily drop makes you laugh, throw a few bucks in the tip jar.</p>
  <a class="btn btn-light" href={url} rel="noopener" target="_blank">
    Tip jar
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square">
      <path d="M7 17L17 7M9 7h8v8"></path>
    </svg>
  </a>
  <p class="note">Opens in a new tab.</p>
</section>

<style>
  .tip {
    flex: 1 1 300px;
  }
  .tip .btn {
    margin-top: auto;
    align-self: flex-start;
  }
</style>
