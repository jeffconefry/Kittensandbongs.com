---
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const status = Astro.url.searchParams.get('signup');
const messages: Record<string, string> = {
  invalid: 'That email address doesn’t look right. Try again?',
  verify: 'We couldn’t verify you’re human. Try again?',
  error: 'Something went wrong sending the confirmation email. Try again in a bit.',
};
const message = status ? messages[status] : undefined;
---

<section id="signup" class="panel panel-accent signup">
  <h2>Get the daily drop</h2>
  <p class="lede">One kitten and one bong in your inbox every morning at 7 a.m. Eastern. Unsubscribe in one click.</p>
  {message && <p class="alert" role="alert">{message}</p>}
  <form method="post" action="/api/subscribe">
    <label class="hp" aria-hidden="true">
      Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
    <input type="hidden" name="ts" value={Date.now()} />
    <div class="row">
      <div class="field">
        <label for="email">Email</label>
        <input id="email" type="email" name="email" required maxlength="254" placeholder="you@example.com" autocomplete="email" />
      </div>
      <button class="btn" type="submit">Subscribe</button>
    </div>
    {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-size="flexible" data-theme="light" />}
    <p class="note">We’ll email you to confirm first. By signing up you confirm you’re 21 or older. Your address is only used for the daily email.</p>
  </form>
  {siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}
</section>

<style>
  .signup {
    flex: 2 1 420px;
  }
  .lede {
    max-width: 46ch;
  }
  form {
    display: grid;
    gap: 0.8rem;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.5rem;
  }
  .row .field {
    flex: 1 1 15rem;
  }
</style>
