---
import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import Pair from '../components/Pair.astro';
import Signup from '../components/Signup.astro';
import TipJar from '../components/TipJar.astro';
import ArchiveGrid from '../components/ArchiveGrid.astro';
import { archive, latestDay } from '../lib/db';
import { nyDay } from '../lib/day';

const today = nyDay();
const [pair, recent] = await Promise.all([latestDay(env.DB, today), archive(env.DB, today, 5)]);
const past = recent.filter((r) => r.day !== pair?.day).slice(0, 4);
const tipUrl = import.meta.env.PUBLIC_TIP_URL;
const sendHour = Number(env.SEND_HOUR ?? 7);
const dropTime = `${sendHour % 12 || 12} ${sendHour < 12 ? 'a.m.' : 'p.m.'} ET`;

Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<Base image={pair?.cat.src_large}>
  {
    pair ? (
      <Pair pair={pair} today={pair.day === today} nextDrop={dropTime} />
    ) : (
      <section class="message">
        <h1>Warming up.</h1>
        <p>The first kitten and bong drop at {dropTime}. Sign up below and they’ll come to you.</p>
      </section>
    )
  }

  <div class="panels">
    <Signup />
    {tipUrl && <TipJar url={tipUrl} />}
  </div>

  {
    past.length > 0 && (
      <section class="past">
        <div class="section-head">
          <h2>Past drops</h2>
          <a class="more-link" href="/archive">
            Full archive →
          </a>
        </div>
        <ArchiveGrid rows={past} />
      </section>
    )
  }
</Base>

<style>
  .panels {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .past {
    margin-top: 3.5rem;
  }
</style>
