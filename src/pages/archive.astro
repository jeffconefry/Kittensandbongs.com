---
import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import ArchiveGrid from '../components/ArchiveGrid.astro';
import { archive } from '../lib/db';
import { nyDay } from '../lib/day';

const rows = await archive(env.DB, nyDay(), 120);
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---

<Base title="Archive · Kittens & Bongs" description="Every kitten and every bong so far.">
  <section class="head">
    <h1>The archive</h1>
    <p class="kicker">Every drop so far, newest first.</p>
  </section>

  {rows.length === 0 ? <p>Nothing here yet. Check back tomorrow.</p> : <ArchiveGrid rows={rows} />}
</Base>

<style>
  .head {
    padding: 2.5rem 0 1.5rem;
    border-bottom: var(--rule);
    margin-bottom: 0.5rem;
  }
  .head h1 {
    margin-bottom: 0.2em;
  }
</style>
